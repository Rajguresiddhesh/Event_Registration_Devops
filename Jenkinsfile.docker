// ==============================================================================
// Jenkinsfile.docker: End-to-End Docker CD Pipeline
// Student: 23102A0003 - SIDDHESH RAJGURE
// Project: Jenkins-Based College Event Registration Platform
// ==============================================================================

pipeline {
    agent any

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '1.0.0',
            description: 'Semantic Version Tag for Docker Image'
        )
        string(
            name: 'CONTAINER_PORT',
            defaultValue: '8080',
            description: 'Host Port for Application Container'
        )
        string(
            name: 'REGISTRY_REPO',
            defaultValue: 'siddheshrajgure/college-event-platform',
            description: 'Target Docker Hub / Registry Repository'
        )
    }

    environment {
        CONTAINER_NAME = 'college-event-platform'
        FULL_IMAGE = "${params.REGISTRY_REPO}:${params.IMAGE_TAG}-${env.BUILD_NUMBER}"
        LATEST_IMAGE = "${params.REGISTRY_REPO}:latest"
    }

    stages {
        stage('1. Checkout Code') {
            steps {
                echo "Fetching codebase for Docker Continuous Deployment..."
                checkout scm
            }
        }

        stage('2. Automated Test Gate') {
            steps {
                echo "Enforcing Quality Gate before container build..."
                sh 'mvn test'
            }
        }

        stage('3. Build Versioned Docker Image') {
            steps {
                echo "Building Docker image: ${FULL_IMAGE}"
                sh "docker build -t ${FULL_IMAGE} -t ${LATEST_IMAGE} ."
            }
        }

        stage('4. Docker Registry Publication') {
            steps {
                echo "Simulating push to Docker Registry / Docker Hub: ${FULL_IMAGE}..."
                // With credentials:
                // withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                //     sh "echo $PASS | docker login -u $USER --password-stdin"
                //     sh "docker push ${FULL_IMAGE}"
                //     sh "docker push ${LATEST_IMAGE}"
                // }
                echo "Image tagged and ready in local registry cache: ${FULL_IMAGE}"
            }
        }

        stage('5. Automated Container Deployment') {
            steps {
                echo "Deploying fresh container instance with zero-downtime replacement..."
                sh """
                    docker stop ${CONTAINER_NAME} || true
                    docker rm ${CONTAINER_NAME} || true
                    docker run -d \\
                        --name ${CONTAINER_NAME} \\
                        --restart unless-stopped \\
                        -p ${params.CONTAINER_PORT}:8080 \\
                        -e PORT=8080 \\
                        ${FULL_IMAGE}
                """
            }
        }

        stage('6. Reliability & Health Verification') {
            steps {
                echo "Performing automated post-deployment health check probe..."
                sh """
                    sleep 10
                    docker ps -f "name=${CONTAINER_NAME}"
                    curl -s -f http://localhost:${params.CONTAINER_PORT}/actuator/health || exit 1
                """
            }
        }
    }

    post {
        always {
            cleanWs deleteDirs: false, notFailBuild: true
        }
        success {
            echo "SUCCESS: Docker Container successfully deployed at http://localhost:${params.CONTAINER_PORT}/!"
        }
        failure {
            echo "FAILURE: Docker deployment failed. Inspect docker logs ${CONTAINER_NAME}."
        }
    }
}
