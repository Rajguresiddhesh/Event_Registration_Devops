// ==============================================================================
// Jenkinsfile.docker: End-to-End Docker CD Pipeline
// Student: 23102A0003 - SIDDHESH RAJGURE
// Project: Jenkins-Based College Event Registration Platform
// ==============================================================================

pipeline {
    agent any

    tools {
        maven 'Maven-3.9.6'
    }

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '1.0.0',
            description: 'Semantic Version Tag for Docker Image'
        )
        string(
            name: 'CONTAINER_PORT',
            defaultValue: '8084',
            description: 'Host Port for Application Container'
        )
    }

    environment {
        CONTAINER_NAME = 'college-event-platform-cd'
        FULL_IMAGE = "event-reg-platform:${params.IMAGE_TAG}-${env.BUILD_NUMBER}"
    }

    stages {
        stage('1. Checkout Code') {
            steps {
                echo "Fetching codebase for Docker Continuous Deployment..."
                checkout scm
            }
        }

        stage('2. Automated Test Gate') {
            steps {
                echo "Enforcing Quality Gate before container build..."
                sh 'mvn clean test -Dselenium.required=true'
            }
        }

        stage('3. Build Versioned Docker Image') {
            steps {
                script {
                    if (!(params.CONTAINER_PORT ==~ /[0-9]{1,5}/) ||
                        params.CONTAINER_PORT.toInteger() < 1 ||
                        params.CONTAINER_PORT.toInteger() > 65535) {
                        error('CONTAINER_PORT must be an integer from 1 to 65535.')
                    }
                    if (!(params.IMAGE_TAG ==~ /[0-9]+\.[0-9]+\.[0-9]+/)) {
                        error('IMAGE_TAG must use semantic version format, for example 1.0.0.')
                    }
                }
                echo "Building Docker image: ${FULL_IMAGE}"
                sh "docker build -t ${FULL_IMAGE} ."
            }
        }

        stage('4. Automated Container Deployment') {
            steps {
                echo "Replacing the demo container using the local Docker engine..."
                sh """
                    docker rm -f ${CONTAINER_NAME} >/dev/null 2>&1 || true
                    docker run -d \\
                        --name ${CONTAINER_NAME} \\
                        --restart unless-stopped \\
                        -p ${params.CONTAINER_PORT}:8080 \\
                        -e PORT=8080 \\
                        ${FULL_IMAGE}
                """
            }
        }

        stage('6. Reliability & Health Verification') {
            steps {
                echo "Performing automated post-deployment health check probe..."
                sh """
                    docker ps -f "name=${CONTAINER_NAME}"
                    curl --fail --show-error --silent \\
                        --retry 12 --retry-connrefused --retry-delay 5 \\
                        http://host.docker.internal:${params.CONTAINER_PORT}/actuator/health
                """
            }
        }
    }

    post {
        always {
            cleanWs deleteDirs: false, notFailBuild: true
        }
        success {
            echo "SUCCESS: Local Docker deployment is healthy at http://localhost:${params.CONTAINER_PORT}/! No registry push was configured."
        }
        failure {
            echo "FAILURE: Docker deployment failed. Inspect docker logs ${CONTAINER_NAME}."
        }
    }
}
